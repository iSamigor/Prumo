<Window x:Class="Prumo.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Prumo.UI"
        Title="Prumo" Width="1180" Height="760" MinWidth="960" MinHeight="600"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}"
        Icon="pack://application:,,,/Prumo;component/Assets/prumo.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,14,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,26">
                    <Image Source="pack://application:,,,/Prumo;component/Assets/prumo.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Prumo" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Equilíbrio de Processos" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="ProBalance ativo" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="PlanText" Text="—" Style="{StaticResource Muted}" Margin="16,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Nav">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Checked="Nav_Checked" Tag="Overview">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Visão geral" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Tag="Processes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Processos" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Tag="Rules">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Regras" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Tag="ProBalance">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F5;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="ProBalance" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Tag="Performance">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Desempenho" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Tag="Automation">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Automação" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Tag="Log">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Registro" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Tag="Settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Ajustes" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar para a bandeja"/>
            </StackPanel>

            <!-- ===== Overview ===== -->
            <Grid x:Name="PageOverview" Grid.Row="1" Margin="28,0,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Visão geral" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="OverviewSub" Text="Monitorando processos" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,14">
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}"/>
                                <TextBlock Text="CPU" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CpuValue" Text="0%" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="CpuSub" Text="16 núcleos lógicos" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Violet}"/>
                                <TextBlock Text="Memória" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="MemValue" Text="0%" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MemSub" Text="—" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#60A5FA"/>
                                <TextBlock Text="GPU" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="GpuValue" Text="0%" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="motor mais ocupado" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Warn}"/>
                                <TextBlock Text="ProBalance" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PbValue" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="PbSub" Text="restrições hoje: 0" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Últimos 2 minutos" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Width="10" Height="3" CornerRadius="1" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU" Style="{StaticResource Muted}" Margin="6,0,14,0"/>
                                <Border Width="10" Height="3" CornerRadius="1" Background="{DynamicResource Violet}" VerticalAlignment="Center"/>
                                <TextBlock Text="Memória" Style="{StaticResource Muted}" Margin="6,0,14,0"/>
                                <Border Width="10" Height="3" CornerRadius="1" Background="#60A5FA" VerticalAlignment="Center"/>
                                <TextBlock Text="GPU" Style="{StaticResource Muted}" Margin="6,0,14,0"/>
                                <Border Width="3" Height="9" CornerRadius="1" Background="{DynamicResource Warn}" VerticalAlignment="Center"/>
                                <TextBlock Text="Restrição do ProBalance" Style="{StaticResource Muted}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <ui:Graph x:Name="MainGraph" Grid.Row="1" MinHeight="140"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Núcleos" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="TopProc" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ItemsControl x:Name="CoreList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Processes ===== -->
            <Grid x:Name="PageProcesses" Grid.Row="1" Margin="28,0,28,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Processos" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="ProcCount" Text="—" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="280">
                        <TextBox x:Name="ProcFilter" Padding="32,0,8,0" TextChanged="ProcFilter_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock x:Name="ProcFilterHint" Text="Filtrar por nome ou PID" Style="{StaticResource Muted}" FontSize="13" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,8,4,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="10,2,22,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource HeaderButton}" Content="Nome" Tag="name" Click="Sort_Click"/>
                            <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Content="PID" Tag="pid" Click="Sort_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Content="CPU" Tag="cpu" Click="Sort_Click"/>
                            <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Content="Memória" Tag="mem" Click="Sort_Click"/>
                            <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Content="Prioridade" Tag="prio" Click="Sort_Click"/>
                            <TextBlock Grid.Column="5" Text="Estado" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                        <ListBox x:Name="ProcList" Grid.Row="1" ContextMenuOpening="ProcList_ContextMenuOpening" PreviewMouseRightButtonDown="ProcList_RightDown">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="ProcMenu"/>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:ProcessRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Exe}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Pid}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Height="18" CornerRadius="4" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Width="{Binding CpuBarWidth}"/>
                                            <TextBlock Text="{Binding CpuText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="{Binding MemText}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PriorityText}" FontSize="12" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource WarnSoft}" Margin="0,0,6,0" Visibility="{Binding RestrainedVisibility}">
                                                <TextBlock Text="restringido" FontSize="11" Foreground="{DynamicResource Warn}"/>
                                            </Border>
                                            <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource AccentSoft}" Margin="0,0,6,0" Visibility="{Binding RuleVisibility}">
                                                <TextBlock Text="regra" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                            <Border CornerRadius="6" Padding="7,2" Background="#1F60A5FA" Visibility="{Binding ForegroundVisibility}">
                                                <TextBlock Text="em foco" FontSize="11" Foreground="#60A5FA"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Rules ===== -->
            <Grid x:Name="PageRules" Grid.Row="1" Margin="28,0,28,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Regras" Style="{StaticResource H1}"/>
                        <TextBlock Text="Aplicadas automaticamente sempre que o programa abrir" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="AddGamesButton" Margin="0,0,8,0" Click="AddGames_Click" ToolTip="Uma regra por biblioteca de jogos (Steam, Epic, Riot, Xbox...): vale para todo jogo instalado nela">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="Adicionar jogos" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                        <Grid Width="240">
                            <TextBox x:Name="NewRuleExe" KeyDown="NewRuleExe_KeyDown"/>
                            <TextBlock x:Name="NewRuleHint" Text="programa.exe ou C:\Pasta\*" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddRule_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OnAccent}"/><TextBlock Text="Nova regra" Margin="8,0,0,0" Foreground="{DynamicResource OnAccent}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="RulesEmpty" Text="Nenhuma regra ainda. Crie uma aqui ou clique com o botão direito num processo." Style="{StaticResource Muted}" FontSize="13" Margin="0,20"/>
                        <ItemsControl x:Name="RuleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:RuleRow}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Margin="0,0,0,12">
                                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}">
                                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Exe}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Kind, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Running, Mode=OneWay}"/></TextBlock>
                                                </StackPanel>
                                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="RemoveRule_Click" Tag="{Binding}" ToolTip="Remover regra">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                                                </Button>
                                            </DockPanel>
                                            <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0">
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Prioridade de CPU" Style="{StaticResource Muted}"/><ui:Help Text='Prioridade com que o Windows distribui a CPU para este programa quando vários disputam ao mesmo tempo.&#10;&#10;Alta: bom para jogos. Abaixo do normal/Ociosa: bom para tarefas pesadas em segundo plano (compactar, renderizar).&#10;Tempo real: perigoso, pode travar mouse e teclado; evite.&#10;"Não alterar" deixa como o programa abriu.'/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding CpuOptions}" SelectedItem="{Binding Cpu}"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Prioridade de I/O" Style="{StaticResource Muted}"/><ui:Help Text="Prioridade de acesso ao disco. Alta: o programa é atendido primeiro ao ler/gravar. Baixa/Muito baixa: bom para downloads, backups e antivírus não atrapalharem."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding IoOptions}" SelectedItem="{Binding Io}"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Prioridade de GPU" Style="{StaticResource Muted}"/><ui:Help Text="Prioridade com que a placa de vídeo atende este programa quando outros também a estão usando (por exemplo, um jogo e um navegador com vídeo)."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding Gpu}"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Prioridade de memória" Style="{StaticResource Muted}"/><ui:Help Text="Quando a RAM aperta, o Windows tira da memória primeiro as páginas de programas com prioridade de memória baixa.&#10;&#10;Baixe para programas de segundo plano; deixe Normal para jogos."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding MemOptions}" SelectedItem="{Binding Memory}" ToolTip="Páginas de memória com prioridade baixa saem da RAM primeiro quando ela aperta"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="GPU preferida" Style="{StaticResource Muted}"/><ui:Help Text="Em PCs com duas placas de vídeo (notebook com integrada + dedicada), escolhe qual o programa usa. Mesma opção de Configurações &gt; Sistema &gt; Tela &gt; Gráficos.&#10;&#10;Vale a partir da próxima vez que o programa abrir."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding GpuPrefOptions}" SelectedItem="{Binding GpuPref}" ToolTip="Vale a partir da próxima vez que o programa abrir"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Afinidade (CPUs)" Style="{StaticResource Muted}"/><ui:Help Text='Prende o programa a estas CPUs lógicas: ele não roda em nenhuma outra. Ex.: "1-7" (da 1 à 7) ou "0,2,4-6".&#10;&#10;Útil para tirar um jogo da CPU 0 ou isolar um programa em poucos núcleos. Vazio = todas as CPUs.'/></StackPanel>
                                                    <TextBox Text="{Binding Affinity, UpdateSourceTrigger=LostFocus}" ToolTip="Só roda nessas CPUs. Ex.: 1-7 ou 0,2,4-6. Vazio = todas"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="CPU Sets (preferência)" Style="{StaticResource Muted}"/><ui:Help Text='Como a afinidade, mas é só uma preferência: o Windows usa estas CPUs primeiro e ainda pode usar outras se precisar. Mais seguro que a afinidade. Mesmo formato: "2-7".'/></StackPanel>
                                                    <TextBox Text="{Binding CpuSets, UpdateSourceTrigger=LostFocus}" ToolTip="O Windows prefere essas CPUs, mas pode usar outras se precisar. Ex.: 2-7"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Boost dinâmico de prioridade" Style="{StaticResource Muted}"/><ui:Help Text='O Windows sobe por instantes a prioridade de threads que acordam (por exemplo, quando chega um clique ou um pacote de rede).&#10;&#10;Desligar deixa a prioridade mais estável; alguns jogos ficam com tempos de quadro mais regulares. "Não alterar" mantém o padrão do Windows.'/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding BoostOptions}" SelectedItem="{Binding Boost}" ToolTip="Desligar evita picos de prioridade das threads; alguns jogos ficam mais estáveis"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Modo de eficiência" Style="{StaticResource Muted}"/><ui:Help Text="Modo de eficiência (EcoQoS) do Windows 11: o programa roda nos núcleos e frequências mais econômicos.&#10;&#10;Ligado: bom para programas de segundo plano. Desligado: garante que o Windows nunca economize energia neste programa (bom para jogos)."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding EfficiencyOptions}" SelectedItem="{Binding Efficiency}"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Modo jogo (plano de energia)" Style="{StaticResource Muted}"/><ui:Help Text="Enquanto este programa estiver aberto, o Prumo troca para este plano de energia; quando ele fecha, volta para o plano normal (definido em Ajustes)."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding PlanOptions}" SelectedItem="{Binding Plan}"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Limitador: % · núcleos · seg." Style="{StaticResource Muted}"/><ui:Help Text="Limitador de CPU: se o programa passar de X% de CPU, fica preso a N núcleos por T segundos e depois volta ao normal.&#10;&#10;Ex.: 50 · 4 · 10 = acima de 50%, só 4 núcleos por 10 s. Bom para programas que de vez em quando ocupam a CPU inteira. Deixe o % vazio para desligar."/></StackPanel>
                                                    <Grid ToolTip="Quando passar de X% de CPU, fica restrito a N núcleos por T segundos. Deixe o % vazio para desligar.">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding LimitPercent, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBox Grid.Column="2" Text="{Binding LimitCores, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBox Grid.Column="4" Text="{Binding LimitSeconds, UpdateSourceTrigger=LostFocus}"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,0" VerticalAlignment="Bottom">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Excluded}" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Excluir do ProBalance" VerticalAlignment="Center"/><ui:Help Text="O ProBalance nunca vai baixar a prioridade deste programa, mesmo quando ele estiver usando muita CPU em segundo plano."/></StackPanel></CheckBox>
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PreventSleep}" Margin="0,0,0,6" ToolTip="O PC não entra em suspensão enquanto este programa estiver aberto (downloads, renderização)"><StackPanel Orientation="Horizontal"><TextBlock Text="Impedir suspensão" VerticalAlignment="Center"/><ui:Help Text="Enquanto este programa estiver aberto, o PC não entra em suspensão sozinho (a tela ainda pode apagar). Bom para downloads longos, renderização e servidores."/></StackPanel></CheckBox>
                                                </StackPanel>
                                            </UniformGrid>
                                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPattern}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Exceto (programas que não são jogos; separados por vírgula, * vale)" Style="{StaticResource Muted}"/><ui:Help Text="Programas dentro da pasta que esta regra deve ignorar, como launchers, ferramentas de crash report e o Wallpaper Engine. Separe por vírgula; * vale qualquer coisa (ex.: *crash*.exe)."/></StackPanel>
                                                <TextBox Text="{Binding ExceptText, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== ProBalance ===== -->
            <ScrollViewer x:Name="PageProBalance" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="ProBalance" Style="{StaticResource H1}"/>
                    <TextBlock Text="Reduz por um tempo a prioridade de processos em segundo plano que monopolizam a CPU, para o que está em foco continuar fluido." Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <CheckBox x:Name="PbEnabled" Style="{StaticResource Switch}" Click="PbChanged">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="ProBalance ligado" Style="{StaticResource H2}"/><ui:Help Text="O ProBalance vigia o uso de CPU o tempo todo. Quando o PC está ocupado e um programa em segundo plano fica usando CPU demais, ele baixa a prioridade desse programa por alguns segundos, para o que você está usando (jogo, navegador, janela em foco) continuar fluido.&#10;&#10;Ele não fecha nem limita o programa: só diz ao Windows para atender os outros primeiro. Quando o programa se acalma, a prioridade original volta.&#10;&#10;Desligado, o Prumo não muda a prioridade de nada sozinho (as suas regras continuam valendo)."/></StackPanel>
                                <TextBlock Text="Desligue para não mexer em nenhum processo automaticamente" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Quando restringir" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                            <UniformGrid Columns="3" Margin="-6,0">
                                <StackPanel Margin="6,0,6,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="CPU total acima de (%)" Style="{StaticResource Muted}"/><ui:Help Text="O ProBalance só age quando o uso total da CPU do PC passa deste valor. Abaixo disso o PC está folgado e ninguém é restringido.&#10;&#10;Valores baixos (10–20%) deixam o ProBalance mais atento; valores altos (50%+) fazem ele agir só quando o PC está realmente carregado."/></StackPanel>
                                    <TextBox x:Name="PbTotal" LostFocus="PbChanged"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,6,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Processo acima de (%)" Style="{StaticResource Muted}"/><ui:Help Text='Quanto da CPU do PC inteiro um único programa precisa usar para ser considerado "pesado". Ex.: 8% num processador de 16 threads é pouco mais de uma thread cheia.&#10;&#10;Só programas acima deste valor (e acima do tempo abaixo) são restringidos.'/></StackPanel>
                                    <TextBox x:Name="PbProc" LostFocus="PbChanged"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,6,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Por pelo menos (ms)" Style="{StaticResource Muted}"/><ui:Help Text="Por quanto tempo seguido o programa precisa ficar acima do limite antes de ser restringido, em milissegundos (1000 ms = 1 segundo).&#10;&#10;Evita restringir picos curtos, como abrir uma aba ou carregar um arquivo."/></StackPanel>
                                    <TextBox x:Name="PbTime" LostFocus="PbChanged"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Restaurar abaixo de (%)" Style="{StaticResource Muted}"/><ui:Help Text="Quando o uso de CPU do programa restringido cai abaixo deste valor, a prioridade original volta (respeitando a restrição mínima)."/></StackPanel>
                                    <TextBox x:Name="PbRestore" LostFocus="PbChanged"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Restrição mínima (ms)" Style="{StaticResource Muted}"/><ui:Help Text="Tempo mínimo que um programa fica restringido, mesmo que se acalme antes. Evita ficar subindo e descendo a prioridade toda hora."/></StackPanel>
                                    <TextBox x:Name="PbMin" LostFocus="PbChanged"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Restrição máxima (ms, 0 = sem limite)" Style="{StaticResource Muted}"/><ui:Help Text="Tempo máximo de uma restrição. Passado esse tempo, a prioridade volta mesmo que o programa continue pesado (ele pode ser restringido de novo depois).&#10;&#10;0 = sem limite: fica restringido enquanto continuar pesado."/></StackPanel>
                                    <TextBox x:Name="PbMax" LostFocus="PbChanged"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Quem fica de fora" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="PbFg" Style="{StaticResource Switch}" Click="PbChanged" Margin="0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Programa em primeiro plano" VerticalAlignment="Center"/><ui:Help Text="Nunca restringe o programa da janela que está ativa agora (a que você está usando). Recomendado deixar ligado."/></StackPanel></CheckBox>
                            <CheckBox x:Name="PbFgChildren" Style="{StaticResource Switch}" Click="PbChanged" Margin="0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Processos filhos do programa em primeiro plano" VerticalAlignment="Center"/><ui:Help Text="Também deixa de fora os processos abertos pelo programa em foco, como as abas de um navegador, o jogo aberto por um launcher ou um compilador chamado por um editor."/></StackPanel></CheckBox>
                            <CheckBox x:Name="PbServices" Style="{StaticResource Switch}" Click="PbChanged" Margin="0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Serviços do Windows" VerticalAlignment="Center"/><ui:Help Text="Deixa de fora os processos que rodam como serviço (sessão 0): antivírus, Windows Update, drivers e afins. Recomendado deixar ligado."/></StackPanel></CheckBox>
                            <CheckBox x:Name="PbOnlyNormal" Style="{StaticResource Switch}" Click="PbChanged" Margin="0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Processos que não estão em prioridade Normal" VerticalAlignment="Center"/><ui:Help Text="Só restringe programas que estão em prioridade Normal. Programas que você (ou o próprio programa) já colocou em outra prioridade não são tocados."/></StackPanel></CheckBox>
                            <TextBlock Text="Programas com uma regra de prioridade de CPU ou com &quot;Excluir do ProBalance&quot; também ficam de fora." Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Como restringir" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="PbIdle" Style="{StaticResource Switch}" Click="PbChanged" Margin="0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Baixar para Ociosa em vez de Abaixo do normal" VerticalAlignment="Center"/><ui:Help Text="Ociosa é a prioridade mais baixa que existe: o programa só usa a CPU quando sobra. Restringe com mais força, mas o programa pode ficar bem lento enquanto isso.&#10;&#10;Desligado, usa Abaixo do normal, que é mais suave."/></StackPanel></CheckBox>
                            <CheckBox x:Name="PbIo" Style="{StaticResource Switch}" Click="PbChanged" Margin="0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Baixar também a prioridade de I/O" VerticalAlignment="Center"/><ui:Help Text="Além da CPU, baixa a prioridade de acesso ao disco do programa restringido, para downloads, instaladores e indexadores não travarem o disco do que você está usando."/></StackPanel></CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Performance ===== -->
            <ScrollViewer x:Name="PagePerformance" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Desempenho" Style="{StaticResource H1}"/>
                    <TextBlock Text="Ajustes globais que valem para o sistema todo. As regras por programa ficam em Regras." Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="PerfMode" Style="{StaticResource Switch}" Click="PerfChanged">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Modo desempenho" Style="{StaticResource H2}"/><ui:Help Text='Mantém o plano de energia escolhido abaixo ativo o tempo todo, e não só quando um programa com "modo jogo" está aberto.&#10;&#10;Planos de alto desempenho deixam o processador sempre pronto (menos atraso para acelerar), mas gastam um pouco mais de energia. Ao desligar, volta o plano anterior.'/></StackPanel>
                                    <TextBlock Text="Mantém o plano de energia abaixo ativo o tempo todo, não só quando um jogo abre" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </CheckBox>
                            <ComboBox x:Name="PerfPlan" Width="320" HorizontalAlignment="Left" Margin="0,12,0,0" SelectionChanged="PerfPlan_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="FgBoost" Style="{StaticResource Switch}" Click="PerfChanged">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Prioridade extra para o programa em foco" Style="{StaticResource H2}"/><ui:Help Text="Sobe a prioridade de CPU da janela que você está usando e devolve a prioridade original quando você troca de janela.&#10;&#10;Ajuda o programa em foco a ganhar a disputa pela CPU contra coisas em segundo plano. Programas com regra de prioridade própria não são alterados."/></StackPanel>
                                    <TextBlock Text="Sobe a prioridade da janela ativa e devolve quando você troca de janela" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ComboBox x:Name="FgBoostPriority" Width="200" SelectionChanged="PerfChanged"/>
                                <CheckBox x:Name="FgBoostOnlyNormal" Style="{StaticResource Switch}" Margin="24,0,0,0" Click="PerfChanged"><StackPanel Orientation="Horizontal"><TextBlock Text="Só se estiver em Normal" VerticalAlignment="Center"/><ui:Help Text="Só dá a prioridade extra se a janela em foco estiver em prioridade Normal. Programas que já têm outra prioridade ficam como estão."/></StackPanel></CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="SmartTrim (memória)" Style="{StaticResource H2}"/><ui:Help Text="Ajuda quando a RAM está quase cheia: tira da RAM as páginas que programas em segundo plano não estão usando, abrindo espaço para o que está em foco.&#10;&#10;O programa continua funcionando; se precisar daquela memória de novo, o Windows traz de volta (pode demorar um instante na primeira vez)."/></StackPanel>
                            <TextBlock Text="Libera RAM de programas em segundo plano quando a memória aperta. Nunca mexe no programa em foco nem em programas com regra de prioridade." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"/>
                            <CheckBox x:Name="TrimOn" Style="{StaticResource Switch}" Click="PerfChanged" Margin="0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="Liberar memória de programas em segundo plano" VerticalAlignment="Center"/><ui:Help Text='Liga a liberação de memória ("trim") dos programas em segundo plano. Nunca mexe no programa em foco, nos filhos dele, em serviços nem em programas com regra de prioridade.'/></StackPanel></CheckBox>
                            <UniformGrid Columns="3" Margin="-6,8,-6,8">
                                <StackPanel Margin="6,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Quando a RAM passar de (%)" Style="{StaticResource Muted}"/><ui:Help Text="Só libera memória quando o uso de RAM do PC estiver acima deste valor. Com a RAM folgada, não faz nada."/></StackPanel>
                                    <TextBox x:Name="TrimLoad" LostFocus="PerfChanged"/>
                                </StackPanel>
                                <StackPanel Margin="6,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Programas acima de (MB)" Style="{StaticResource Muted}"/><ui:Help Text="Só libera memória de programas que estão usando mais do que isto. Programas pequenos não compensam."/></StackPanel>
                                    <TextBox x:Name="TrimMinMb" LostFocus="PerfChanged"/>
                                </StackPanel>
                                <StackPanel Margin="6,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="No máximo a cada (minutos)" Style="{StaticResource Muted}"/><ui:Help Text="Intervalo mínimo entre duas liberações, para não ficar fazendo isso o tempo todo."/></StackPanel>
                                    <TextBox x:Name="TrimInterval" LostFocus="PerfChanged"/>
                                </StackPanel>
                            </UniformGrid>
                            <CheckBox x:Name="PurgeOn" Style="{StaticResource Switch}" Click="PerfChanged" Margin="0,8,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="Limpar a lista de espera (cache) quando a RAM livre acabar" VerticalAlignment="Center"/><ui:Help Text="O Windows guarda na RAM uma cópia de arquivos usados recentemente (lista de espera). Normalmente isso é bom, mas alguns jogos engasgam quando a RAM livre acaba.&#10;&#10;Ligado, o Prumo limpa esse cache quando a RAM livre fica abaixo do valor abaixo (no máximo a cada 5 minutos)."/></StackPanel></CheckBox>
                            <StackPanel Margin="0,8,0,0" Width="250" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Quando sobrar menos de (MB livres)" Style="{StaticResource Muted}"/><ui:Help Text="Limpa a lista de espera quando a memória livre de verdade ficar abaixo deste valor, em MB."/></StackPanel>
                                <TextBox x:Name="PurgeBelow" LostFocus="PerfChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Resolução do timer do Windows" Style="{StaticResource H2}"/><ui:Help Text='Define a precisão do relógio interno usado para esperas curtas. 0,5 ms ou 1 ms deixa pausas curtas mais precisas, o que alguns jogos e programas de áudio aproveitam.&#10;&#10;Custa um pouco mais de energia. Vale só enquanto o Prumo estiver aberto; "Padrão do Windows" não mexe em nada.'/></StackPanel>
                            <TextBlock Text="Um timer mais fino deixa esperas curtas mais precisas. No Windows 11 o efeito é pequeno e vale só enquanto o Prumo estiver aberto." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"/>
                            <ComboBox x:Name="TimerRes" Width="250" HorizontalAlignment="Left" SelectionChanged="PerfChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Automation ===== -->
            <ScrollViewer x:Name="PageAutomation" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,24" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Automação" Style="{StaticResource H1}"/>
                    <TextBlock Text="O que o Prumo faz sozinho quando um programa abre, fecha ou passa do limite" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox x:Name="AutoLogOnly" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutoLogOnly_Click" ToolTip="Não fecha: só anota no Registro quando um desses programas abrir"><StackPanel Orientation="Horizontal"><TextBlock Text="Só registrar" VerticalAlignment="Center"/><ui:Help Text="Em vez de fechar, só anota no Registro quando um programa proibido abrir. Bom para testar a lista antes de ligar de verdade."/></StackPanel></CheckBox>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Processos proibidos" Style="{StaticResource H2}"/><ui:Help Text="Programas que você não quer rodando nunca: o Prumo fecha cada um assim que ele abre (verifica uma vez por segundo).&#10;&#10;Vale nome (app.exe), padrão com * (*updater*.exe) ou pasta (C:\Pasta\*). Serviços e processos do Windows nunca são fechados."/></StackPanel>
                            </DockPanel>
                            <TextBlock Text="Fechados assim que abrem. Vale nome (app.exe), padrão (*updater*.exe) ou pasta (C:\Pasta\*). Serviços e processos do Windows nunca são fechados." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="320">
                                    <TextBox x:Name="DisallowedBox" KeyDown="AddDisallowed_ClickKey"/>
                                    <TextBlock Text="programa.exe" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=DisallowedBox, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>
                                <Button Margin="8,0,0,0" Content="Adicionar" Click="AddDisallowed_Click"/>
                            </StackPanel>
                            <ItemsControl x:Name="DisallowedList" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,4,4,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"/>
                                                <Button Style="{StaticResource GhostButton}" Margin="4,0,0,0" Padding="6,2" Tag="{Binding}" Click="RemoveDisallowed_Click" ToolTip="Remover">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Manter rodando" Style="{StaticResource H2}"/><ui:Help Text="Se um destes programas fechar ou travar e cair, o Prumo abre de novo com os mesmos argumentos, como o seu usuário (nunca como administrador).&#10;&#10;Espera 2, 4, 8... segundos entre tentativas e desiste se o programa fechar 5 vezes em 10 minutos. Fechar pelo menu Processos do Prumo não reabre."/></StackPanel>
                            <TextBlock Text="Se um desses programas fechar (ou travar e cair), o Prumo abre de novo com os mesmos argumentos, como o seu usuário (não como administrador). Para de tentar se fechar 5 vezes em 10 minutos." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="320">
                                    <TextBox x:Name="KeepBox" KeyDown="AddKeep_ClickKey"/>
                                    <TextBlock Text="programa.exe" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=KeepBox, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>
                                <Button Margin="8,0,0,0" Content="Adicionar" Click="AddKeep_Click"/>
                            </StackPanel>
                            <ItemsControl x:Name="KeepList" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,4,4,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"/>
                                                <Button Style="{StaticResource GhostButton}" Margin="4,0,0,0" Padding="6,2" Tag="{Binding}" Click="RemoveKeep_Click" ToolTip="Remover">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Novo vigia" Click="AddWatchdog_Click"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Vigia" Style="{StaticResource H2}"/><ui:Help Text='Regras do tipo "se acontecer isto, faça aquilo": quando um programa passa do limite de CPU ou de RAM por um tempo seguido, o Prumo age.&#10;&#10;Depois de agir, espera pelo menos 1 minuto antes de agir de novo no mesmo processo. O interruptor à esquerda de cada vigia liga ou desliga só ele.'/></StackPanel>
                            </DockPanel>
                            <TextBlock Text="Quando um programa passar do limite de CPU ou de RAM por um tempo, o Prumo age. Depois de agir, espera pelo menos 1 minuto antes de agir de novo no mesmo processo." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock x:Name="WatchdogEmpty" Text="Nenhum vigia ainda." Style="{StaticResource Muted}" Margin="0,4"/>
                            <ItemsControl x:Name="WatchdogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:WatchdogRow}">
                                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Bottom" Margin="0,0,10,6" ToolTip="Ligado"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Programa" Style="{StaticResource Muted}"/><ui:Help Text="Nome do programa (app.exe), padrão com * ou pasta (C:\Pasta\*)."/></StackPanel>
                                                    <TextBox Text="{Binding Exe, UpdateSourceTrigger=LostFocus}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Medida" Style="{StaticResource Muted}"/><ui:Help Text="O que vigiar: CPU (% do PC inteiro) ou RAM (MB usados pelo programa)."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding MetricOptions}" SelectedItem="{Binding Metric}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Acima de" Style="{StaticResource Muted}"/><ui:Help Text="Limite: % de CPU ou MB de RAM, conforme a medida escolhida."/></StackPanel>
                                                    <TextBox Text="{Binding Threshold, UpdateSourceTrigger=LostFocus}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Por (seg.)" Style="{StaticResource Muted}"/><ui:Help Text="Por quantos segundos seguidos o programa precisa ficar acima do limite antes do vigia agir."/></StackPanel>
                                                    <TextBox Text="{Binding Seconds, UpdateSourceTrigger=LostFocus}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Então" Style="{StaticResource Muted}"/><ui:Help Text="O que fazer: só registrar; reduzir a prioridade para Abaixo do normal; liberar a memória dele; reiniciar (fecha e abre de novo com os mesmos argumentos); ou fechar."/></StackPanel>
                                                    <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding WhatToDo}"/>
                                                </StackPanel>
                                                <Button Grid.Column="6" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="RemoveWatchdog_Click" Tag="{Binding}" ToolTip="Remover vigia">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="IdleOn" Style="{StaticResource Switch}" Click="IdleChanged" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="IdleSaver" FontWeight="SemiBold"/><ui:Help Text="Quando você fica um tempo sem usar teclado e mouse, troca para um plano de energia mais econômico; assim que você mexer, volta o plano normal.&#10;&#10;Não age com jogo aberto (programa com regra de prioridade Alta), com algo em tela cheia (vídeo, apresentação) nem com o modo desempenho ligado."/></StackPanel>
                                    <TextBlock Text="Com o PC parado (sem teclado e mouse), troca para um plano de energia econômico; volta assim que você mexer. Não age enquanto o modo desempenho ou um modo jogo estiver ativo." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Ocioso depois de (min)" Style="{StaticResource Muted}"/><ui:Help Text="Minutos sem teclado e mouse para o PC contar como ocioso."/></StackPanel>
                                    <TextBox x:Name="IdleMinutes" Width="140" LostFocus="IdleChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Plano enquanto ocioso" Style="{StaticResource Muted}"/><ui:Help Text="Plano de energia usado enquanto o PC está ocioso. Equilibrado é o mais seguro; Economia de energia economiza mais, mas deixa tudo mais lento."/></StackPanel>
                                    <ComboBox x:Name="IdlePlan" Width="320" SelectionChanged="IdlePlan_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Log ===== -->
            <Grid x:Name="PageLog" Grid.Row="1" Margin="28,0,28,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Registro" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="LogCount" Text="—" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="200" Margin="0,0,8,0">
                            <TextBox x:Name="LogSearch" Padding="32,0,8,0" TextChanged="LogFilter_SelectionChanged"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            <TextBlock Text="Buscar" Style="{StaticResource Muted}" FontSize="13" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=LogSearch, Converter={StaticResource EmptyToVisible}}"/>
                        </Grid>
                        <ComboBox x:Name="LogFilter" Width="170" SelectionChanged="LogFilter_SelectionChanged"/>
                        <Button Margin="8,0,0,0" Content="Exportar" Click="ExportLog_Click" ToolTip="Salva os eventos mostrados num arquivo .txt"/>
                        <Button Margin="8,0,0,0" Content="Copiar diagnóstico" Click="CopyDiagnostics_Click" ToolTip="Copia versão, Windows, configuração e os últimos eventos, para colar num relato de problema"/>
                        <Button Margin="8,0,0,0" Content="Abrir pasta" Click="OpenLogFolder_Click"/>
                        <Button Margin="8,0,0,0" Content="Limpar" Click="ClearLog_Click"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <ListBox x:Name="LogList">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:LogRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Color}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Who}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ===== Settings ===== -->
            <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Ajustes" Style="{StaticResource H1}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Aparência" Style="{StaticResource H2}"/><ui:Help Text="Tema das cores do Prumo. Azul é o original; Claro tem fundo branco; Preto é todo preto, ótimo para telas OLED e para usar à noite. Troca na hora."/></StackPanel>
                            <TextBlock Text="Azul é o tema original; Claro tem fundo branco; Preto é todo preto (bom para telas OLED)" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ComboBox x:Name="SetTheme" Width="320" HorizontalAlignment="Left" SelectionChanged="Theme_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="SetAutostart" Style="{StaticResource Switch}" Click="Autostart_Click" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold"/><ui:Help Text='Abre o Prumo na bandeja quando você entra no Windows, já com permissão de administrador e sem pedido do UAC (usa uma tarefa agendada "Prumo").&#10;&#10;Sem isso, as regras e o ProBalance só funcionam quando você abrir o Prumo.'/></StackPanel>
                                    <TextBlock Text="Abre direto na bandeja, com permissão de administrador e sem aviso nenhum" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="SetCloseToTray" Style="{StaticResource Switch}" Click="CloseToTray_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Fechar para a bandeja" FontWeight="SemiBold"/><ui:Help Text="O X da janela só esconde o Prumo: ele continua rodando perto do relógio. Para sair de verdade, use o botão direito no ícone da bandeja &gt; Sair."/></StackPanel>
                                    <TextBlock Text="O X da janela só esconde; o gerenciamento continua" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Plano de energia" Style="{StaticResource H2}"/><ui:Help Text="Mostra o plano de energia ativo agora e para qual plano o Prumo volta quando o modo jogo, o modo desempenho ou o IdleSaver terminam."/></StackPanel>
                            <TextBlock x:Name="SetPlanNow" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Ao sair do modo jogo, voltar para" Style="{StaticResource Muted}"/><ui:Help Text='"O plano que estava ativo antes" volta exatamente para o que estava antes de o Prumo trocar. Escolha um plano fixo se quiser sempre voltar para ele.'/></StackPanel>
                            <ComboBox x:Name="SetDefaultPlan" Width="320" HorizontalAlignment="Left" SelectionChanged="DefaultPlan_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Backup da configuração" Style="{StaticResource H2}"/><ui:Help Text="Exportar: salva todas as regras e ajustes num arquivo .json. Importar: carrega um arquivo exportado (substitui a configuração atual). Restaurar padrões: apaga tudo e volta ao início."/></StackPanel>
                            <TextBlock Text="Salve as regras e os ajustes num arquivo para guardar, levar para outro PC ou anexar num relato de problema." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Exportar..." Click="ExportConfig_Click"/>
                                <Button Margin="8,0,0,0" Content="Importar..." Click="ImportConfig_Click"/>
                                <Button Margin="8,0,0,0" Content="Restaurar padrões" Click="ResetConfig_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Process Lasso" Style="{StaticResource H2}"/><ui:Help Text="Lê o prolasso.ini do Process Lasso e traz as regras de prioridade, afinidade, I/O, GPU, modo jogo e as opções do ProBalance. Substitui as regras atuais do Prumo."/></StackPanel>
                            <TextBlock Text="Importa de novo as regras e o ProBalance do prolasso.ini. Substitui a configuração atual do Prumo." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Importar do Process Lasso" Click="Import_Click"/>
                                <TextBlock x:Name="LassoState" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" Margin="4,18,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
