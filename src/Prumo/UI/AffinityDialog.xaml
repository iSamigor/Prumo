<Window x:Class="Prumo.UI.AffinityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afinidade de CPU" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="CpuToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the shadow inside the transparent window -->
    <Grid Margin="18">
        <Border CornerRadius="14" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel x:Name="Header" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Cancelar"/>
                    <StackPanel>
                        <TextBlock Text="Afinidade de CPU" Style="{StaticResource H2}" FontSize="17"/>
                        <TextBlock x:Name="ExeText" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="-3,0,-3,10">
                    <Button Content="Todas" Tag="all" Click="Quick_Click" Padding="11,4" FontSize="12" Margin="3"/>
                    <Button Content="Nenhuma" Tag="none" Click="Quick_Click" Padding="11,4" FontSize="12" Margin="3"/>
                    <Button Content="Pares" Tag="even" Click="Quick_Click" Padding="11,4" FontSize="12" Margin="3"/>
                    <Button Content="Ímpares" Tag="odd" Click="Quick_Click" Padding="11,4" FontSize="12" Margin="3"/>
                    <Button Content="Sem a CPU 0" Tag="no0" Click="Quick_Click" Padding="11,4" FontSize="12" Margin="3"/>
                </WrapPanel>

                <Border Grid.Row="2" Background="{DynamicResource Bg}" CornerRadius="10" Padding="8"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel x:Name="CpuHost"/>
                </Border>

                <TextBlock x:Name="MaskText" Grid.Row="3" Style="{StaticResource Muted}" Margin="2,10,2,0"
                           TextTrimming="CharacterEllipsis"/>

                <CheckBox x:Name="AlwaysSwitch" Grid.Row="4" Style="{StaticResource Switch}" Margin="0,12,0,0"
                          Content="Aplicar sempre que abrir (salvar como regra)"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Cancelar" Click="Cancel_Click" MinWidth="88"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="Aplicar"
                            Click="Apply_Click" MinWidth="96" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
